# Copy to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string (async driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cinecloud

# Log every SQL statement - keep false outside local debugging
SQL_ECHO=false

# Database connections per backend process. Every replica opens its own pool:
# replicas * (DB_POOL_SIZE + DB_MAX_OVERFLOW) must stay below the server's
# max_connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis for temporary seat holds and live seat-map updates.
# Unlike PostgreSQL it holds nothing that must survive a restart.
REDIS_URL=redis://localhost:6379/0

# Keycloak signs the cinema admins in; the backend only verifies the tokens it
# issues, so it holds no secret for them. Locally Keycloak runs in a container
# with the realm from the repository (Git Bash: prefix MSYS_NO_PATHCONV=1):
#   docker run -d --name cinecloud-keycloak -p 8080:8080 \
#     -e KC_BOOTSTRAP_ADMIN_USERNAME=admin -e KC_BOOTSTRAP_ADMIN_PASSWORD=admin \
#     -v "$PWD/k8s/base/cinecloud-realm.json:/opt/keycloak/data/import/cinecloud-realm.json:ro" \
#     quay.io/keycloak/keycloak:26.8.1 start-dev --import-realm --http-relative-path=/auth
# Admin console: http://localhost:8080/auth/admin - accounts are created there
# and linked to a cinema with scripts/create_tenant.py (see k8s/README.md).
OIDC_ISSUER=http://localhost:8080/auth/realms/cinecloud
# Only needed when the backend reaches Keycloak under another address than
# the browser does, as inside the cluster
# OIDC_JWKS_URL=

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# text for a terminal, json in the cluster where a log collector reads stdout
LOG_FORMAT=text
