erDiagram
    Cinemas ||--o{ CinemaAdmins : employs
    Cinemas ||--o{ Movies : offers
    Cinemas ||--o{ Halls : owns
    Cinemas ||--o{ Showtimes : schedules
    Cinemas ||--o{ Bookings : receives

    Halls ||--o{ Seats : contains
    Halls ||--o{ Showtimes : hosts
    Movies ||--o{ Showtimes : "shown as"

    Showtimes ||--o{ Bookings : "booked in"
    Bookings ||--|{ BookingSeats : contains
    Seats ||--o{ BookingSeats : "sold as"
    Showtimes ||--o{ BookingSeats : sells

    Cinemas {
        int id PK
        string name
        string slug UK
        datetime created_at
    }

    CinemaAdmins {
        int id PK
        int cinema_id FK
        string email UK
        string password_hash
        datetime created_at
    }

    Movies {
        int id PK
        int cinema_id FK
        string title
        string description
        int release_year
        int duration_minutes
        string poster_key
    }

    Halls {
        int id PK
        int cinema_id FK
        string name
    }

    Seats {
        int id PK
        int hall_id FK
        int row_number "UNIQUE (hall_id, row_number, seat_number)"
        int seat_number
    }

    Showtimes {
        int id PK
        int cinema_id FK
        int movie_id FK
        int hall_id FK
        datetime start_time
        decimal ticket_price
    }

    Bookings {
        int id PK
        int cinema_id FK
        int showtime_id FK "UNIQUE (id, showtime_id) as target for BookingSeats"
        string reference UK
        string guest_email
        string status
        decimal total_price
        datetime created_at
    }

    BookingSeats {
        int booking_id PK, FK "FK (booking_id, showtime_id) to Bookings"
        int seat_id PK, FK
        int showtime_id FK "UNIQUE (showtime_id, seat_id): sold at most once"
    }
